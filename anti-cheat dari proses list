#!/system/bin/sh
# Jalan sebagai root. Detach FFAC dari /proc, hide dari maps scan.

PKG="com.dts.freefireth"
PID=$(pidof $PKG)

# 1. Hide dari mount namespace — remount /proc
mount -o remount,rw /proc
echo "0" > /proc/sys/kernel/yama/ptrace_scope

# 2. Zygisk DenyList — masukin package ke list supaya zygisk detach
ZYGISC_DB="/data/adb/zygisk"
mkdir -p $ZYGISC_DB
echo "$PKG" >> "$ZYGISC_DB/denylist"
echo "$PKG" >> "$ZYGISC_DB/zygisk_denylist"

# 3. Resetprop buat spoof build fingerprint — biar anti-cheat gak detek root
resetprop ro.build.tags release-keys
resetprop ro.build.type user
resetprop ro.debuggable 0
resetprop ro.secure 1
resetprop ro.boot.verifiedbootstate green
resetprop ro.boot.flash.locked 1

# 4. Kill + restart FFAC service supaya re-init tanpa hook
stop garena_ac
sleep 1
start garena_ac

echo "[ALPHA XK] kernel layer done — FFAC detached"