#!/system/bin/sh
# Jalankan sebagai root. Backup maps asli, filter nama sensitive.

PROC_DIR="/proc/$1/maps"
BACKUP="/data/local/tmp/maps_backup_$1"

cp "$PROC_DIR" "$BACKUP" 2>/dev/null

# Pattern yang harus hilang dari scan AC
PATTERNS="frida|magisk|zygisk|riru|xposed|lsposed|substrate|ff_hook|gadget|linjector|re.frida.server"

# Bikin namespace override — bind mount file filtered ke maps
FILTERED="/data/local/tmp/maps_filtered_$1"
grep -Ev "$PATTERNS" "$BACKUP" > "$FILTERED"
chmod 644 "$FILTERED"

mount --bind "$FILTERED" "$PROC_DIR"

echo "[ALPHA XK] maps filtered — pattern sensitive hilang"